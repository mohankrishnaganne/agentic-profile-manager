{
  "family": "ai-worker-service",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::900376493406:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::900376493406:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "ai-worker-container",
      "image": "900376493406.dkr.ecr.us-east-1.amazonaws.com/agentic-profile-repo-worker:latest",
      "environment": [
        { "name": "REDIS_HOST", "value": "agentic-redis-broker-kb03jz.serverless.use1.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "S3_BUCKET_NAME", "value": "agentic-profile-uploads-wichita" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agentic-worker-logs",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "essential": true
    }
  ]
}