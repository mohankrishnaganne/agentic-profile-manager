{
  "family": "web-api-service",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::900376493406:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::900376493406:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "web-api-container",
      "image": "900376493406.dkr.ecr.us-east-1.amazonaws.com/agentic-profile-repo-web:latest",
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "FLASK_SECRET_KEY", "value": "your-secure-flask-key" },
        { "name": "REDIS_HOST", "value": "agentic-redis-broker-xxxx.serverless.use1.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "S3_BUCKET_NAME", "value": "agentic-profile-uploads-wichita" },
        { "name": "GH_CLIENT_ID", "value": "your-github-id" },
        { "name": "GITHUB_CLIENT_SECRET", "value": "your-github-secret" },
        { "name": "VERCEL_CLIENT_ID", "value": "your-vercel-id" },
        { "name": "VERCEL_CLIENT_SECRET", "value": "your-vercel-secret" }
      ],
      "essential": true
    }
  ]
}